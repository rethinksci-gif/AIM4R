{
  "ai": {
    "provider": "deepseek",
    "provider_chain": null,
    "model": "deepseek-v4-flash",
    "base_url": null,
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 0.0,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1,
    "languages": ["zh"],
    "azure_endpoint_env": null,
    "api_version": null
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 50,
      "category": "tech",
      "profile": null
    },
    "rss": [
      {
        "name": "IEEE Spectrum Robotics",
        "url": "https://spectrum.ieee.org/feeds/topic/robotics.rss",
        "enabled": true,
        "category": "robotics",
        "profile": null
      },
      {
        "name": "The Robot Report",
        "url": "https://www.therobotreport.com/feed/",
        "enabled": true,
        "category": "robotics",
        "profile": null
      },
      {
        "name": "Robohub",
        "url": "https://robohub.org/feed/",
        "enabled": true,
        "category": "robotics",
        "profile": null
      },
      {
        "name": "arXiv Robotics",
        "url": "https://rss.arxiv.org/rss/cs.RO",
        "enabled": true,
        "category": "research",
        "profile": "tech-blog"
      },
      {
        "name": "arXiv Materials Science",
        "url": "https://rss.arxiv.org/rss/cond-mat.mtrl-sci",
        "enabled": true,
        "category": "materials",
        "profile": "tech-blog"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "robotics",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 5,
          "category": "robotics",
          "profile": null
        },
        {
          "subreddit": "reinforcementlearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 5,
          "category": "robotics",
          "profile": null
        },
        {
          "subreddit": "MaterialsScience",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 3,
          "category": "materials",
          "profile": null
        }
      ],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": { "enabled": false, "channels": [] },
    "twitter": null,
    "openbb": null,
    "ossinsight": {
      "enabled": false,
      "period": "past_24_hours",
      "languages": ["All", "Python", "TypeScript"],
      "keywords": [],
      "min_stars": 5,
      "max_items": 30,
      "category": null,
      "profile": null
    },
    "gdelt": null,
    "google_news": null
  },
  "collection": { "time_window_hours": 24 },
  "digest": {
    "max_items": 20,
    "category_groups": {
      "robotics": {
        "name": "机器人与具身智能",
        "limit": 8,
        "categories": ["robotics"]
      },
      "materials": {
        "name": "材料",
        "limit": 5,
        "categories": ["materials"]
      },
      "research": {
        "name": "前沿论文",
        "limit": 5,
        "categories": ["research"]
      }
    },
    "default_group": "other",
    "default_group_limit": 3,
    "profile_order": ["tech-news", "tech-blog", "finance-news"]
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": { "threshold": 6.0, "topic_dedup": true },
      "tech-blog": { "threshold": 6.5, "topic_dedup": true },
      "finance-news": { "threshold": 7.0, "topic_dedup": true }
    }
  },
  "display": { "icon_style": "emoji" },
  "extractors": {},
  "email": null,
  "webhook": null
}
